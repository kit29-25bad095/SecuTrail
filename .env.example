# ============================================================
# SECUTRAIL PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production or set in your hosting platform (Vercel, Railway, Render, etc.)
# ============================================================

# [APPLICATION]
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://secutrail.org"
NEXT_PUBLIC_APP_NAME="SecuTrail"

# [QUICK EXIT]
# Neutral, safe website for immediate redirect upon clicking Quick Exit or double-ESC
NEXT_PUBLIC_QUICK_EXIT_URL="https://weather.com"

# [DEMO MODE]
# Set to "false" in full production deployments where external PostgreSQL is configured
# Set to "true" for evaluator/sandbox deployments with verified in-memory fallback
NEXT_PUBLIC_ENABLE_DEMO_MODE="false"

# [DATABASE CONFIGURATION]
# Production PostgreSQL connection string (supports Supabase, AWS RDS, Neon, etc.)
DATABASE_URL="postgresql://user:password@hostname:5432/secutrail?sslmode=require&schema=public"

# [SESSION SECURITY]
# Cryptographically secure random secret (32+ characters, e.g. generated via `openssl rand -hex 32`)
# Used for HMAC hashing client rate-limiting keys without storing raw IPs
SESSION_SECRET="generate-a-secure-32-byte-hex-string-for-production"

# [ADMIN AUTHORIZATION]
# Secret bearer key required to access /api/admin/* endpoints
ADMIN_API_KEY="generate-a-secure-high-entropy-admin-api-key"

# [AI / LLM PROVIDER]
# Options: "mock" (built-in deterministic verified responses) or "production" (OpenAI / Claude API)
LLM_PROVIDER="mock"
LLM_API_KEY=""
LLM_MODEL="gpt-4o"

# [RESOURCE PROVIDER]
# Options: "production" (PostgreSQL Resource table) or "demo" (built-in verified registry)
RESOURCE_PROVIDER="production"
